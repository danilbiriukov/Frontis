{
  "name": "frontis",
  "type": "module",
  "version": "0.0.3",
  "description": "Консольная утилита для аудита фронтенд-проектов через Code PushUp с результатами в JSON",
  "scripts": {
    "clean": "node -e \"import('node:fs').then(f => f.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc && node -e \"import('node:fs').then(f => f.chmodSync('dist/cli.js', 0o755))\"",
    "dev": "tsc --watch",
    "prepublishOnly": "node scripts/pack-release.mjs",
    "lint": "oxlint --deny-warnings",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "pack:release": "npm run build && node scripts/pack-release.mjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/semver": "7.8.0",
    "knip": "6.44.1",
    "oxlint": "1.91.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@code-pushup/core": "0.126.4",
    "@code-pushup/coverage-plugin": "0.126.4",
    "@code-pushup/eslint-plugin": "0.126.4",
    "@code-pushup/js-packages-plugin": "0.126.4",
    "@code-pushup/models": "0.126.4",
    "eslint": "9.39.5",
    "jiti": "2.7.0",
    "semver": "7.8.5"
  },
  "homepage": "https://github.com/danilbiriukov/Frontis#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danilbiriukov/Frontis.git"
  },
  "bugs": {
    "url": "https://github.com/danilbiriukov/Frontis/issues"
  },
  "bin": {
    "frontis": "dist/cli.js"
  },
  "keywords": [
    "frontend",
    "audit",
    "cli",
    "report",
    "html-report",
    "knip",
    "eslint",
    "npm-audit"
  ],
  "author": "Biriukov Danil <danilbiriukovv@gmail.com>",
  "license": "Apache-2.0",
  "overrides": {
    "@code-pushup/utils": {
      "simple-git": "4.0.2",
      "glob": "14.0.4"
    },
    "@code-pushup/eslint-plugin": {
      "glob": "14.0.4"
    }
  }
}
